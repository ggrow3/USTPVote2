{
  "name": "ustp-server",
  "version": "0.1.0",
  "description": "USTPVote2 backend: api and worker Cloud Run services from one NestJS (Fastify) codebase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "firebase emulators:exec --config ../../firebase.json --project demo-ustpvote --only auth,firestore,storage \"vitest run --config vitest.int.config.ts\"",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "dev:api": "node --watch-path=dist dist/main-api.js",
    "dev:worker": "node --watch-path=dist dist/main-worker.js",
    "emulators": "firebase emulators:start --config ../../firebase.json --project demo-ustpvote --only auth,firestore,storage",
    "dev:api:emulators": "node scripts/dev-api-emulators.mjs",
    "dev:api:emulators:mfa": "node scripts/dev-api-emulators.mjs --require-mfa",
    "dev:worker:emulators": "node scripts/dev-worker-emulators.mjs",
    "seed:emulators": "node scripts/seed-emulators.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "@google-cloud/vision": "^6.2.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ustp-audit": "^0.1.0",
    "ustp-domain": "^0.1.0",
    "ustp-tally": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "firebase-tools": "^15.34.2",
    "ustp-verify": "^0.1.0"
  }
}
