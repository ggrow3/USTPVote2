{
  "name": "ustp-server",
  "version": "0.1.0",
  "description": "USTPVote2 backend: api and worker Cloud Run services from one NestJS (Fastify) codebase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "dev:api": "node --watch-path=dist dist/main-api.js",
    "dev:worker": "node --watch-path=dist dist/main-worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ustp-tally": "^0.1.0"
  }
}
