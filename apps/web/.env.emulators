# `npm run dev:emulators -w apps/web`: local Auth emulator, emulator-only demo project, no App Check.
# Nothing here is secret; real projects take their values from the deploy environment.
VITE_USE_EMULATORS=true
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_PROJECT_ID=demo-ustpvote
VITE_FIREBASE_AUTH_DOMAIN=demo-ustpvote.firebaseapp.com
