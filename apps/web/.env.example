# Firebase web config for a real environment (ustpvote2-dev / -staging / -prod). Copy to .env.<mode>.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (required outside the emulators).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# The site's own address (https://host) for link previews, when it is not the Hosting default https://<project>.web.app.
VITE_SITE_ORIGIN=
# Another name for the site in this environment than apps/web/.env's; uncomment only to set one (empty stops the build).
# VITE_APP_NAME="USTP Vote (dev)"
