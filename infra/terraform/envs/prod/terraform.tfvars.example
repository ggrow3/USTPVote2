# Copy to terraform.tfvars (ignored by git: it holds people's addresses). server_image is the first image, which the
# services are created with; keep it set. Later releases come from the release workflow (README "Release workflow").

# server_image = "us-central1-docker.pkg.dev/ustpvote2-prod/ustpvote/server@sha256:<64 hex digits>"

bootstrap_system_admin_emails = ["first.admin@example.org", "second.admin@example.org"]

# The release workflow's ustp-release may already push and attest; list anyone else who needs to.
image_publishers    = []
attestation_signers = []

operator_members = ["group:ustp-voting-operators@example.org"]
alert_emails     = ["ustp-voting-alerts@example.org"]

# Q11: confirm the period with USTP first. Keep false until then; true locks IRREVERSIBLY (README "Bucket Lock").
anchors_retention_days   = 3653
anchors_retention_locked = false

# Sends bylaws drafts to Anthropic for the advisory check; a System Admin then adds the API key in the app (README).
bylaws_check_enabled = false

# Sends an election's proposals to Anthropic when a voter on its roll, or an Election Admin or Auditor, asks for the
# platform consistency check (once each per election); uses the same API key (README).
consistency_check_enabled = false

# Sends an election's rules, offices and proposal texts, with the bylaws, to Anthropic when an Election Admin or Auditor
# asks for the election setup check (once per version); every user then sees its notes beside the contests (README).
election_check_enabled = false

# A Google map on the Candidates page (design §5.8), with a browser key restricted to the web app's origins. Google
# bills map loads beyond its monthly free usage.
maps_enabled = true

# Election notices by Amazon SES (design §6.8): set SES up and add the aws-ses-* secret versions first (README
# "Election notices"). The From address is the module default, USTP Elections <noreply@transhumanist-party.org>.
# web_origin           = "https://vote.example.org"  # empty: https://<project>.web.app
# mail_transport       = "ses"
# notice_contact       = "elections@example.org"
# ses_region           = "us-east-1"
# ses_events_queue_url = "https://sqs.us-east-1.amazonaws.com/123456789012/ustp-notice-events"
