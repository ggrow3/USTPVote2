{
  "name": "ustp-audit",
  "version": "0.1.0",
  "description": "Canonical hashing (RFC 8785), hash chains, RFC 9162 Merkle proofs and ballot commitments for USTP elections",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
