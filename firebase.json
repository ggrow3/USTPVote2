{
  "firestore": {
    "rules": "infra/firebase/firestore.rules",
    "indexes": "infra/firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "infra/firebase/storage.rules"
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["**/.*"],
    "rewrites": [
      { "source": "/v1/**", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/mcp", "run": { "serviceId": "mcp", "region": "us-central1" } },
      { "source": "/robots.txt", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/sitemap.xml", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/news/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/candidates/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/course/certificates/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/course/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/results/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/events/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/embed/**", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/legislation", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/legislation/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/scorecard", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/scorecard/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/races/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/races/*/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "/people/*", "run": { "serviceId": "api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
        ]
      },
      {
        "source": "/version.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/embed/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'sha256-GiHRwxgO4vfKryc4tCXIrq3V8asHgbtpsVSfEIZceg4='; style-src 'sha256-LIp27NpUwc4HBRV9xmZuyag1ggUq9pVlPrd8bc23PvU='; img-src 'self' https:; media-src 'self'; frame-src https://www.youtube-nocookie.com; base-uri 'none'; form-action 'none'; frame-ancestors *"
          },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8085 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}
